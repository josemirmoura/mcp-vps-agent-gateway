[Unit]
Description=MCP VPS Agent Privileged Broker
After=local-fs.target

[Service]
Type=simple
User=root
Group=vps-agent
EnvironmentFile=-/etc/vps-agent/broker.env
ExecStart=/usr/local/bin/vps-agent-broker
Restart=on-failure
RestartSec=2
RuntimeDirectory=vps-agent
RuntimeDirectoryMode=0750
StateDirectory=vps-agent
StateDirectoryMode=0750
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/vps-agent /var/lib/vps-agent -/tmp/vps-agent-poc
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
