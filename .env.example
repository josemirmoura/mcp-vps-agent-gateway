# Copy to .env and replace every CHANGE_ME value.
# Generate tokens with: openssl rand -hex 32

VPS_AGENT_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
VPS_AGENT_STATIC_TOKEN=CHANGE_ME_MCP_TOKEN
VPS_AGENT_SUBJECT=operator

# Stable per-installation identity; init.sh replaces CHANGE_ME_INSTANCE_ID.
VPS_AGENT_INSTANCE_ID=CHANGE_ME_INSTANCE_ID
VPS_AGENT_INSTANCE_NAME=vps-agent

# Local bind by default. Put a TLS reverse proxy in front for ChatGPT Web.
VPS_AGENT_BIND_ADDRESS=127.0.0.1
VPS_AGENT_PORT=8080

# static is ONLY for local/lab validation and automated acceptance.
# Public ChatGPT write-capable connections require standards-based OAuth/OIDC.
VPS_AGENT_AUTH_MODE=static
VPS_AGENT_OIDC_ISSUER=
# Defaults to VPS_AGENT_OAUTH_RESOURCE when left blank.
VPS_AGENT_OIDC_AUDIENCE=
VPS_AGENT_REQUIRED_SCOPES=
# Canonical OAuth resource identifier. For ChatGPT use the public MCP URL.
VPS_AGENT_OAUTH_RESOURCE=
# Usually auto-derived as https://<host>/.well-known/oauth-protected-resource.
VPS_AGENT_RESOURCE_METADATA_URL=

# Optional published images. Local builds are used by default.
VPS_AGENT_GATEWAY_IMAGE=mcp-vps-agent-gateway:local
VPS_AGENT_BROKER_IMAGE=mcp-vps-agent-broker:local

# Public HTTPS URL used by the ChatGPT connection tutorial.
# Example: https://mcp.example.com/mcp
VPS_AGENT_PUBLIC_URL=
VPS_AGENT_DOMAIN=
VPS_AGENT_CHATGPT_VERIFY_TIMEOUT=10m
